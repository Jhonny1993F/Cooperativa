@using System.Security.Claims
@model Cooperativa.Models.Eventos

@{
    // Recuperar el socioID desde los claims
    var socioId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Decidir el layout basado en el socioID
    Layout = socioId == "2"
        ? "~/Views/Shared/AdministradorLayout.cshtml"
        : "~/Views/Shared/GeneralLayout.cshtml";
}

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

<h3>¿Deseas eliminar este evento?</h3>
<div>
    <h4>Eventos</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.fechaEvento) *@
            <label>Fecha del evento:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaEvento)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.tipoEvento) *@
            <label>Tipo de evento:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.tipoEvento)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.costoEvento) *@
            <label>Costo del evento:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.costoEvento)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.detalleEvento) *@
            <label>Detalle del evento:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.detalleEvento)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.lugar) *@
            <label>Lugar:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.lugar)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.socio) *@
            <label>Socio:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.socio)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="eventoID" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Regresar al menu principal</a>
    </form>
</div>
