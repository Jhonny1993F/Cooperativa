@model Cooperativa.Models.Utilidades

@{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
}

@{
    ViewData["Title"] = "Create";
}

<h1>Crear</h1>

<h4>Utilidades</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                @* <label asp-for="utilidadTotal" class="control-label"></label> *@
                <label>Utilidad total:</label>
                <input asp-for="utilidadTotal" class="form-control" readonly />
            </div>

            <div class="form-group">
                @* <label asp-for="utilidadPorSocio" class="control-label"></label> *@
                <label>Utilidad por socio:</label>
                <input asp-for="utilidadPorSocio" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label>Fecha de Utilidad</label>
                <input type="text" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" readonly />
                @Html.HiddenFor(m => m.fechaUtilidad, new { Value = DateTime.Now }) <!-- Campo oculto para la fecha -->
            </div>

            <div class="form-group">
                @* <label asp-for="socio" class="control-label"></label> *@
                <label>Seleccione al socio:</label>
                <select asp-for="socio" class="form-control" asp-items="ViewBag.socio">
                    <option value="" disabled selected>--- Seleccione un socio ---</option>
                </select>
                <span asp-validation-for="socio" class="text-danger"></span>
            </div>

            <div class="form-group">
                @* <label asp-for="inscripcion" class="control-label"></label> *@
                <label>Inscripcion:</label>
                <input asp-for="inscripcion" class="form-control" readonly />
            </div>

            <div class="form-group">
                @* <label asp-for="interes" class="control-label"></label> *@
                <label>Cantidad total de intereses:</label>
                <input asp-for="interes" class="form-control" readonly />
            </div>

            <div class="form-group">
                @* <label asp-for="totalCredito" class="control-label"></label> *@
                <label>Cantidad total de creditos:</label>
                <input asp-for="totalCredito" class="form-control" readonly />
            </div>

            <div class="form-group">
                @* <label asp-for="costoEvento" class="control-label"></label> *@
                <label>Cantidad total de costo de eventos por socio:</label>
                <input asp-for="costoEvento" class="form-control" readonly />
            </div>

            <div class="form-group">
                @* <label asp-for="montoAhorro" class="control-label"></label> *@
                <label>Cantidad total de ahorros por socio</label>
                <input asp-for="montoAhorro" class="form-control" readonly />
            </div>

            <div class="form-group">
                @* <label asp-for="costoPasivo" class="control-label"></label> *@
                <label>Cantidad total de costo de pasivos por socio:</label>
                <input asp-for="costoPasivo" class="form-control" readonly />
            </div>

            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Regresar al menu principal</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}






