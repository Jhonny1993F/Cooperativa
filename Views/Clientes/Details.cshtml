        <dt class = "col-sm-2">
            <label> Contraseña:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.contraseña)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.clienteID">Editar</a> |
    <a asp-action="Index">Regresar al menu principal</a>
</div>
