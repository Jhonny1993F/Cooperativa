@model Cooperativa.Models.Transferencias

@{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
}

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Transferencias</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cantidadTransferencia) *@
            <label>Cantidad de la transferencia:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cantidadTransferencia)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.fechaTransferencia) *@
            <label>Fecha de la transferencia:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaTransferencia)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.detalleTransferencia) *@
            <label>Detalle de la transferencia:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.detalleTransferencia)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cliente) *@
            <label>Cliente:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cliente)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.transferenciaID">Editar</a> |
    <a asp-action="Index">Regresar al menu principal</a>
</div>
