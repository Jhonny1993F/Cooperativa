@using System.Security.Claims
@model Cooperativa.Models.Clientes

@{
    var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var admin = User?.FindFirst("Admin")?.Value; // Recuoera al admin
    var tipoUsuario = User?.FindFirst("TipoUsuario")?.Value; // Recuperar tipo de usuario

    bool isAdmin = admin == "Administrador"; // El ID 2 es el administrador
    bool isSocio = tipoUsuario == "Socio"; // Si está en la tabla SOCIOS
    bool isCliente = tipoUsuario == "Cliente"; // Si está en la tabla CLIENTES

    if (isAdmin)
    {
        Layout = "~/Views/Shared/AdministradorLayout.cshtml";
    }
    else if (isSocio)
    {
        Layout = "~/Views/Shared/GeneralLayout.cshtml";
    }
    else if (isCliente)
    {
        Layout = "~/Views/Shared/UsuarioLayout.cshtml";
    }
}

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Clientes</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            <label> Nombres:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.nombres)
        </dd>
        <dt class = "col-sm-2">
            <label> Apellidos:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.apellidos)
        </dd>
        <dt class = "col-sm-2">
            <label> Cedula:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cedula)
        </dd>
        <dt class = "col-sm-2">
            <label> Fecha de nacimiento:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaNacimiento)
        </dd>
        <dt class = "col-sm-2">
            <label> Dirección:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.direccion)
        </dd>
        <dt class = "col-sm-2">
            <label> Telefono:</label>
        </dt>
