@model Cooperativa.Models.Utilidades

@{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
}

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Utilidades</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.utilidadTotal) *@
            <label>Utilidad total:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.utilidadTotal)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.utilidadPorSocio) *@
            <label>Utilidad por socio:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.utilidadPorSocio)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.fechaUtilidad) *@
            <label>Fecha de utilidad:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaUtilidad)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.socio) *@
            <label>Socio:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.socio)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.inscripcion) *@
            <label>Inscripcion:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.inscripcion)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.interes) *@
            <label>Interes total:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.interes)
