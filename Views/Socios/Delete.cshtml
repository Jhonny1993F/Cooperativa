@model Cooperativa.Models.Socios
@using System.Security.Claims

@{
    // Recuperar el socioID desde los claims
    var socioId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Decidir el layout basado en el socioID
    Layout = socioId == "2"
        ? "~/Views/Shared/AdministradorLayout.cshtml"
        : "~/Views/Shared/GeneralLayout.cshtml";
}

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2>Eliminar Socio</h2>

<h3>Estas seguro de querer eliminar a este socio?</h3>
<div>
    <h4>Socios</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.nombres) *@
            <label> Nombres:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.nombres)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.apellidos) *@
            <label> Apellidos:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.apellidos)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cedula) *@
            <label> Cedula:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cedula)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.fechaNacimiento) *@
            <label> Fecha de nacimiento:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaNacimiento)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.direccion) *@
            <label> Dirección:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.direccion)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.telefono) *@
            <label> Telefono:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.telefono)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.socio) *@
            <label> Socio:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.socio)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.inscripcion) *@
            <label> Inscripcion:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.inscripcion)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.correo) *@
            <label> Correo elctronico:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.correo)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.contraseña) *@
            <label> Contraseña:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.contraseña)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="socioID" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Regresar al menu principal</a>
    </form>
</div>

