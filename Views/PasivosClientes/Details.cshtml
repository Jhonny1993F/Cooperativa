@model Cooperativa.Models.PasivosClientes

@{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
}

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Pasivos de clientes</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.tipo) *@
            <label>Tipo:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.tipo)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.costoPasivo) *@
            <label>Costo del pasivo:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.costoPasivo)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.detallePasivo) *@
            <label>Detalle:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.detallePasivo)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.fechaPasivo) *@
            <label>Fecha:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaPasivo)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cliente) *@
            <label>Cliente:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cliente)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.pasivoClienteID">Editar</a> |
    <a asp-action="Index">Regresar al menu principal</a>
</div>
