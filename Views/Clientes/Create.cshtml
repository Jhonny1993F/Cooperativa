@using System.Security.Claims
@model Cooperativa.Models.Clientes



@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    ViewData["Title"] = "Create";
}

<h1>Crear</h1>

<h4>Clientes</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                @* <label asp-for="nombres" class="control-label"></label> *@
                <label> Ingrese sus nombres:</label>
                <input asp-for="nombres" class="form-control" placeholder="Ejemplo: Iker Sebastian"/>
                <span asp-validation-for="nombres" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="apellidos" class="control-label"></label> *@
                <label> Ingrese sus apellidos:</label>
                <input asp-for="apellidos" class="form-control" placeholder="Ejemplo: Molina Bravo"/>
                <span asp-validation-for="apellidos" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="cedula" class="control-label"></label> *@
                <label> Ingrese su numero de cedula:</label>
                <input asp-for="cedula" class="form-control" placeholder="Ejemplo: 0123456789"/>
                <span asp-validation-for="cedula" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="fechaNacimiento" class="control-label"></label> *@
                <label> Ingrese su fecha de nacimiento:</label>
                <input asp-for="fechaNacimiento" class="form-control" placeholder="Ejemplo: 01/01/1999"/>
                <span asp-validation-for="fechaNacimiento" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="direccion" class="control-label"></label> *@
                <label> Ingrese su direccion:</label>
                <input asp-for="direccion" class="form-control" placeholder="Ejemplo: Pedro Aguirre S15-144 y Jaime Enriquez"/>
                <span asp-validation-for="direccion" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="telefono" class="control-label"></label> *@
                <label> Ingrese su numero de telefono:</label>
                <input asp-for="telefono" class="form-control" placeholder="Ejemplo: 0912345678"/>
                <span asp-validation-for="telefono" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="cliente" class="control-label"></label> *@
                <label> Ingrese su primer nombre y primer apellido:</label>
                <input asp-for="cliente" class="form-control" placeholder="Ejemplo: Iker Molina"/>
                <span asp-validation-for="cliente" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="inscripcion" class="control-label"></label> *@
                <label> Ingrese el valor de la inscripción:</label>
                <input asp-for="inscripcion" class="form-control" value="5.00" readonly/>
                <span asp-validation-for="inscripcion" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="correo" class="control-label"></label> *@
                <label> Ingrese su correo electronico:</label>
                <input asp-for="correo" class="form-control" placeholder="Ejemplo: ejemplo@gmail.com"/>
                <span asp-validation-for="correo" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="contraseña" class="control-label"></label> *@
                <label> Ingrese una contraseña:</label>
                <input asp-for="contraseña" class="form-control" placeholder="***"/>
                <span asp-validation-for="contraseña" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Regresar al menu principal</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
