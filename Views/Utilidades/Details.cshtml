        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.costoEvento)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.montoAhorro) *@
            <label>Ahorro total:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.montoAhorro)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.costoPasivo) *@
            <label>Pasivo por socio:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.costoPasivo)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.utilidadID">Editar</a> |
    <a asp-action="Index">Regresar al menu principal</a>
</div>
