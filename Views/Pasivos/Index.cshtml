@model IEnumerable<Cooperativa.Models.Pasivos>
@using System.Security.Claims

@* @{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
} *@

@{
    // Recuperar el socioID desde los claims
    var socioId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Decidir el layout basado en el socioID
    Layout = socioId == "2"
        ? "~/Views/Shared/AdministradorLayout.cshtml"
        : "~/Views/Shared/GeneralLayout.cshtml";
}

@{
    ViewData["Title"] = "Index";
}

<h1>Pasivos</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @* @Html.DisplayNameFor(model => model.tipo) *@
                <label>Tipo:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.costoPasivo) *@
                <label>Costo del pasivo:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.detalle) *@
                <label>Detalle:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.fechaPasivo) *@
                <label>Fecha:</label>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.tipo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.costoPasivo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.detalle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaPasivo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.pasivoID">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.pasivoID">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.pasivoID">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
