@using System.Security.Claims
@model Cooperativa.Models.Creditos

@{
    var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var admin = User?.FindFirst("Admin")?.Value; // Recuoera al admin
    var tipoUsuario = User?.FindFirst("TipoUsuario")?.Value; // Recuperar tipo de usuario

    bool isAdmin = admin == "Administrador"; // El ID 2 es el administrador
    bool isSocio = tipoUsuario == "Socio"; // Si está en la tabla SOCIOS
    bool isCliente = tipoUsuario == "Cliente"; // Si está en la tabla CLIENTES

    if (isAdmin)
    {
        Layout = "~/Views/Shared/AdministradorLayout.cshtml";
    }
    else if (isSocio)
    {
        Layout = "~/Views/Shared/GeneralLayout.cshtml";
    }
    else if (isCliente)
    {
        Layout = "~/Views/Shared/UsuarioLayout.cshtml";
    }
}

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Creditos</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.montoCredito) *@
            <label> Monto del credito:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.montoCredito)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.fechaCredito) *@
            <label>Fecha de Crédito:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaCredito)
        </dd>
        <dt class="col-sm-2">
            @* @Html.DisplayNameFor(model => model.tiempo) *@
            <label> Tipo de credito:</label>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.tipoCredito)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.tiempo) *@
            <label> Tiempo de finaciamiento:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.tiempo)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.interes) *@
            <label> Interes:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.interes)
        </dd>
        <dt class="col-sm-2">
            @* @Html.DisplayNameFor(model => model.interes) *@
            <label> Interes mensual:</label>
        </dt>
        <dd class="col-sm-10">
            @{
                var interes = Model.tiempo <= 3 ? "2.5%" :
                Model.tiempo <= 6 ? "1.5%" :
                Model.tiempo <= 9 ? "1.27%" :
                Model.tiempo <= 12 ? "1.1%" : null;
            }
            @if (!string.IsNullOrEmpty(interes))
            {
                @interes
            }
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cuota) *@
            <label> Valor de la cuota:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cuota)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.estado) *@
            <label> Estado del credito:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.estado)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.totalCredito) *@
            <label> Monto total del credito:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.totalCredito)
        </dd>
        @if (isSocio)
        {
            <dt class="col-sm-2">
                @* @Html.DisplayNameFor(model => model.socio) *@
                <label> Socio:</label>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.socio)
            </dd>
        }else if (isCliente)
        {
            <dt class="col-sm-2">
                @* @Html.DisplayNameFor(model => model.socio) *@
                <label> Cliente:</label>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cliente)
            </dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.creditoID">Editar</a> |
    <a asp-action="Index">Regresar al menu principal</a>
</div>
