@using System.Security.Claims
@model Cooperativa.Models.Ahorros

@{
    var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var admin = User?.FindFirst("Admin")?.Value; // Recuoera al admin
    var tipoUsuario = User?.FindFirst("TipoUsuario")?.Value; // Recuperar tipo de usuario

    bool isAdmin = admin == "Administrador"; // El ID 2 es el administrador
    bool isSocio = tipoUsuario == "Socio"; // Si está en la tabla SOCIOS
    bool isCliente = tipoUsuario == "Cliente"; // Si está en la tabla CLIENTES

    if (isAdmin)
    {
        Layout = "~/Views/Shared/AdministradorLayout.cshtml";
    }
    else if (isSocio)
    {
        Layout = "~/Views/Shared/GeneralLayout.cshtml";
    }
    else if (isCliente)
    {
        Layout = "~/Views/Shared/UsuarioLayout.cshtml";
    }
}

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

<h3>Ahorros</h3>
<div>
    <h4>¿Deseas eliminar este ahorro?</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            <label> Monto del ahorro:</label>
            @* @Html.DisplayNameFor(model => model.montoAhorro) *@
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.montoAhorro)
        </dd>
        <dt class = "col-sm-2">
            <label> Comprobante:</label>
            @* @Html.DisplayNameFor(model => model.comprobante) *@
        </dt>
        <dd class = "col-sm-10">
            @* @Html.DisplayFor(model => model.comprobante) *@
            @if (!string.IsNullOrEmpty(Model.comprobante))
            {
                <img src="@Model.comprobante" alt="Comprobante" width="200" />
            }
        </dd>
        <dt class = "col-sm-2">
            <label> Fecha del ahorro:</label>
            @* @Html.DisplayNameFor(model => model.fechaAhorro) *@
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaAhorro)
        </dd>
        <dt class = "col-sm-2">
            <label> Detalle del ahorro:</label>
            @* @Html.DisplayNameFor(model => model.detalleAhorro) *@
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.detalleAhorro)
        </dd>
        <dt class = "col-sm-2">
            <label> Socio:</label>
            @* @Html.DisplayNameFor(model => model.socio) *@
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.socio)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ahorroID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Regresar al menu principal</a>
    </form>
</div>
