@using System.Security.Claims
@model Cooperativa.Models.Bancos

@{
    var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var tipoUsuario = User?.FindFirst("TipoUsuario")?.Value; // Recuperar tipo de usuario

    bool isAdmin = userId == "2"; // El ID 2 es el administrador
    bool isSocio = tipoUsuario == "Socio"; // Si está en la tabla SOCIOS
    bool isCliente = tipoUsuario == "Cliente"; // Si está en la tabla CLIENTES

    if (isAdmin)
    {
        Layout = "~/Views/Shared/AdministradorLayout.cshtml";
    }
    else if (isSocio)
    {
        Layout = "~/Views/Shared/GeneralLayout.cshtml";
    }
    else if (isCliente)
    {
        Layout = "~/Views/Shared/UsuarioLayout.cshtml";
    }
}

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Bancos</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BancoID" />
            <div class="form-group">
                @* <label asp-for="nombre" class="control-label"></label> *@
                <label> Ingrese el nombre del banco:</label>
                <input asp-for="nombre" class="form-control" />
                <span asp-validation-for="nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="interesBanco" class="control-label"></label> *@
                <label> Interes del banco:</label>
                <input asp-for="interesBanco" class="form-control" />
                <span asp-validation-for="interesBanco" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="cantidad" class="control-label"></label> *@
                <label> Seleccione la cantidad a simular:</label>
                @* <input asp-for="cantidad" class="form-control" /> *@
                <select asp-for="cantidad" class="form-control" asp-items="ViewBag.cantidad">
                    <option value="" disabled selected>--- Seleccione una cantidad ---</option>
                </select>
                <span asp-validation-for="cantidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="comparacion" class="control-label"></label> *@
                <label> Valor a comparar:</label>
                <input asp-for="comparacion" class="form-control" />
                <span asp-validation-for="comparacion" class="text-danger"></span>
            </div>
            @* <div class="form-group">
                <label asp-for="creditoID" class="control-label"></label>
                <select asp-for="creditoID" class="form-control" asp-items="ViewBag.creditoID"></select>
                <span asp-validation-for="creditoID" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                @* <label asp-for="interes" class="control-label"></label> *@
                <label> Seleccione un monto con el interes local:</label>
                @* <input asp-for="interes" class="form-control" /> *@
                <select asp-for="interes" class="form-control" asp-items="ViewBag.interes">
                    <option value="" disabled selected>--- Seleccione una cantidad ---</option>
                </select>
                <span asp-validation-for="interes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Regresar al menu principal</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
