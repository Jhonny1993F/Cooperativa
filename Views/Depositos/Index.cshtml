@model IEnumerable<Cooperativa.Models.Depositos>
@using System.Security.Claims

@* @{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
} *@

@{
    // Recuperar el socioID desde los claims
    var socioId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Decidir el layout basado en el socioID
    Layout = socioId == "2"
        ? "~/Views/Shared/AdministradorLayout.cshtml"
        : "~/Views/Shared/GeneralLayout.cshtml";
}

@{
    ViewData["Title"] = "Index";
}

<h1>Depositos</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @* @Html.DisplayNameFor(model => model.cantidadDeposito) *@
                <label> Cantidad de deposito:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.fechaDeposito) *@
                <label> Fecha de deposito:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.detalleDeposito) *@
                <label> Detalle del deposito:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.cliente) *@
                <label> Cliente:</label>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.cantidadDeposito)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaDeposito)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.detalleDeposito)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.cliente)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.depositoID">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.depositoID">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.depositoID">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
