@using System.Security.Claims
@model Cooperativa.Models.Eventos

@{
    // Recuperar el socioID desde los claims
    var socioId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Decidir el layout basado en el socioID
    Layout = socioId == "2"
        ? "~/Views/Shared/AdministradorLayout.cshtml"
        : "~/Views/Shared/GeneralLayout.cshtml";
}

@{
    ViewData["Title"] = "Create";
}

<h1>Crear</h1>

<h4>Eventos</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label>Fecha del evento:</label>
                <input type="text" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" readonly />
                @Html.HiddenFor(m => m.fechaEvento, new { Value = DateTime.Now }) <!-- Campo oculto para la fecha -->
            </div>
            <div class="form-group">
                @* <label asp-for="tipoEvento" class="control-label"></label> *@
                <label>Seleccione el tipo de evento:</label>
                @* <input asp-for="tipoEvento" class="form-control" /> *@
                <select asp-for="tipoEvento" class="form-control">
                    <option value="" disabled selected>--- Seleccione el tipo de estado ---</option>
                    <option value="INTERNO QUINCENAL">INTERNO QUINCENAL</option>
                    <option value="INTERNO FINAL">INTERNO FINAL</option>
                    <option value="GRANDE">GRANDE</option>
                </select>
                <span asp-validation-for="tipoEvento" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="costoEvento" class="control-label"></label> *@
                <label>Ingrese el costo de evento:</label>
                <input asp-for="costoEvento" class="form-control" placeholder="Ejemplo: 10"/>
                <span asp-validation-for="costoEvento" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="detalleEvento" class="control-label"></label> *@
                <label>Detalle del evento:</label>
                <input asp-for="detalleEvento" class="form-control" placeholder="Cafe y rifa"/>
                <span asp-validation-for="detalleEvento" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="lugar" class="control-label"></label> *@
                <label>Ingrese el lugar:</label>
                <input asp-for="lugar" class="form-control" placeholder="Chilibulo"/>
                <span asp-validation-for="lugar" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="socio" class="control-label"></label> *@
                <label>Seleccione un socio:</label>
                @* <input asp-for="socio" class="form-control" /> *@
                <select asp-for="socio" class="form-control" asp-items="ViewBag.socio">
                    <option value="" disabled selected>--- Seleccione un socio ---</option>
                </select>
                <span asp-validation-for="socio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Regresar al menu principal</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
