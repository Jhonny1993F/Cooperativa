@using System.Security.Claims
@model Cooperativa.Models.Bancos

@{
    var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var tipoUsuario = User?.FindFirst("TipoUsuario")?.Value; // Recuperar tipo de usuario

    bool isAdmin = userId == "2"; // El ID 2 es el administrador
    bool isSocio = tipoUsuario == "Socio"; // Si está en la tabla SOCIOS
    bool isCliente = tipoUsuario == "Cliente"; // Si está en la tabla CLIENTES

    if (isAdmin)
    {
        Layout = "~/Views/Shared/AdministradorLayout.cshtml";
    }
    else if (isSocio)
    {
        Layout = "~/Views/Shared/GeneralLayout.cshtml";
    }
    else if (isCliente)
    {
        Layout = "~/Views/Shared/UsuarioLayout.cshtml";
    }
}

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Bancos</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.nombre) *@
            <label> Nombre del banco:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.nombre)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.interesBanco) *@
            <label> Interes del banco:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.interesBanco)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cantidad) *@
            <label> Cantidad:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cantidad)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.comparacion) *@
            <label> Comparacion:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.comparacion)
        </dd>
        @* <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.creditos)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.creditos.creditoID)
        </dd> *@
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.interes) *@
            <label> Interes local:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.interes)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.BancoID">Editar</a> |
    <a asp-action="Index">Regresar al menu principal</a>
</div>
