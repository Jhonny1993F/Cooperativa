@model Cooperativa.Models.Depositos

@{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
}

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

<h3>¿Deseas eliminar este deposito?</h3>
<div>
    <h4>Depositos</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cantidadDeposito) *@
            <label> Cantidad de deposito:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cantidadDeposito)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.fechaDeposito) *@
            <label> Fecha de deposito:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaDeposito)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.detalleDeposito) *@
            <label> Detalle del deposito:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.detalleDeposito)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cliente) *@
            <label> Cliente:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cliente)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="depositoID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Regresar al menu principal</a>
    </form>
</div>
