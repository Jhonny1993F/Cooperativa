@using System.Security.Claims
@model Cooperativa.Models.Ahorros

@{
    var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var admin = User?.FindFirst("Admin")?.Value; // Recuoera al admin
    var tipoUsuario = User?.FindFirst("TipoUsuario")?.Value; // Recuperar tipo de usuario

    bool isAdmin = admin == "Administrador"; // El ID 2 es el administrador
    bool isSocio = tipoUsuario == "Socio"; // Si está en la tabla SOCIOS
    bool isCliente = tipoUsuario == "Cliente"; // Si está en la tabla CLIENTES

    if (isAdmin)
    {
        Layout = "~/Views/Shared/AdministradorLayout.cshtml";
    }
    else if (isSocio)
    {
        Layout = "~/Views/Shared/GeneralLayout.cshtml";
    }
    else if (isCliente)
    {
        Layout = "~/Views/Shared/UsuarioLayout.cshtml";
    }
}

@{
    ViewData["Title"] = "Edit";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Editar</h1>

<h4>Ahorros</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ahorroID" />
            <div class="form-group">
                <label> Ingrese el monto del ahorro:</label>
                @* <label asp-for="montoAhorro" class="control-label"></label> *@
                <input asp-for="montoAhorro" class="form-control" />
                <span asp-validation-for="montoAhorro" class="text-danger"></span>
            </div>
            @* <div class="form-group">
                <label> Comprobante:</label>
                <label asp-for="comprobante" class="control-label"></label>
                <input asp-for="comprobante" class="form-control" />
                <span asp-validation-for="comprobante" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label for="comprobanteArchivo">Comprobante</label>
                <input type="file" class="form-control" name="nuevoComprobante" accept=".jpg,.png,.pdf" />
                <span asp-validation-for="comprobante" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Fecha del Ahorro:</label>
                @* <label asp-for="fechaAhorro" class="control-label"></label> *@
                <input asp-for="fechaAhorro" class="form-control" readonly/>
                <span asp-validation-for="fechaAhorro" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label> Detalle del ahorro:</label>
                @* <label asp-for="detalleAhorro" class="control-label"></label> *@
                <input asp-for="detalleAhorro" class="form-control" />
                <span asp-validation-for="detalleAhorro" class="text-danger"></span>
            </div>
            @if (isAdmin)
            {
                <div class="form-group">
                    <label>Seleccione el socio:</label>
                    <select asp-for="socio" class="form-control" asp-items="ViewBag.socio">
                        <option value="" disabled selected>--- Seleccione un socio ---</option>
                    </select>
                    <span asp-validation-for="socio" class="text-danger"></span>
                </div>
            }
            else if (isSocio)
            {
                <div class="form-group">
                    <label>Seleccione el socio:</label>
                    <select asp-for="socio" class="form-control" asp-items="ViewBag.socio">
                        <option value="" disabled selected>--- Seleccione un socio ---</option>
                    </select>
                    <span asp-validation-for="socio" class="text-danger"></span>
                </div>
            }
            else if (isCliente)
            {
                <div class="form-group">
                    <label>Seleccione el cliente:</label>
                    <select asp-for="cliente" class="form-control" asp-items="ViewBag.cliente">
                        <option value="" disabled selected>--- Seleccione un cliente ---</option>
                    </select>
                    <span asp-validation-for="cliente" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Regresar al menu principal</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
