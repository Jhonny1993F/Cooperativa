@model IEnumerable<Cooperativa.Models.Transferencias>
@using System.Security.Claims

@* @{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
} *@

@{
    // Recuperar el socioID desde los claims
    var socioId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Decidir el layout basado en el socioID
    Layout = socioId == "2"
        ? "~/Views/Shared/AdministradorLayout.cshtml"
        : "~/Views/Shared/GeneralLayout.cshtml";
}

@{
    ViewData["Title"] = "Index";
}

<h1>Transferencias</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @* @Html.DisplayNameFor(model => model.cantidadTransferencia) *@
                <label>Cantidad de la transferencia:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.fechaTransferencia) *@
                <label>Fecha de la transferencia:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.detalleTransferencia) *@
                <label>Detalle de la transferencia:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.cliente) *@
                <label>Cliente:</label>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.cantidadTransferencia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaTransferencia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.detalleTransferencia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.cliente)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.transferenciaID">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.transferenciaID">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.transferenciaID">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
