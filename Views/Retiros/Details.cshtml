@model Cooperativa.Models.Retiros

@{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
}

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Retiros</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cantidadRetiro) *@
            <label>Cantidad de retiro:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cantidadRetiro)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.fechaRetiro) *@
            <label>Fecha de retiro:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaRetiro)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.detalleRetiro) *@
            <label>Detalle del retiro:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.detalleRetiro)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.cliente) *@
            <label>Cliente:</label>
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cliente)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.retiroID">Editar</a> |
    <a asp-action="Index">Regresar al menu principal</a>
</div>
