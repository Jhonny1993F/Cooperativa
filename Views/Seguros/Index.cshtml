@using System.Security.Claims
@model IEnumerable<Cooperativa.Models.Seguros>

@{
    var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var tipoUsuario = User?.FindFirst("TipoUsuario")?.Value; // Recuperar tipo de usuario

    bool isAdmin = userId == "2"; // El ID 2 es el administrador
    bool isSocio = tipoUsuario == "Socio"; // Si está en la tabla SOCIOS
    bool isCliente = tipoUsuario == "Cliente"; // Si está en la tabla CLIENTES

    if (isAdmin)
    {
        Layout = "~/Views/Shared/AdministradorLayout.cshtml";
    }
    else if (isSocio)
    {
        Layout = "~/Views/Shared/GeneralLayout.cshtml";
    }
    else if (isCliente)
    {
        Layout = "~/Views/Shared/UsuarioLayout.cshtml";
    }
}

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.valor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fechaSeguro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.tiempo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.socios)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.socio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.inscripcion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.valor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaSeguro)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tipo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.tiempo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.socios.socioID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.socio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.inscripcion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.seguroID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.seguroID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.seguroID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
