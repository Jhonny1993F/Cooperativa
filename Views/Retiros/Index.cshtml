@model IEnumerable<Cooperativa.Models.Retiros>
@using System.Security.Claims

@* @{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
} *@

@{
    // Recuperar el socioID desde los claims
    var socioId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Decidir el layout basado en el socioID
    Layout = socioId == "2"
        ? "~/Views/Shared/AdministradorLayout.cshtml"
        : "~/Views/Shared/GeneralLayout.cshtml";
}

@{
    ViewData["Title"] = "Index";
}

<h1>Retiros</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @* @Html.DisplayNameFor(model => model.cantidadRetiro) *@
                <label>Cantidad de retiro:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.fechaRetiro) *@
                <label>Fecha de retiro:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.detalleRetiro) *@
                <label>Detalle del retiro:</label>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.cliente) *@
                <label>Cliente:</label>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.cantidadRetiro)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaRetiro)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.detalleRetiro)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.cliente)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.retiroID">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.retiroID">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.retiroID">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
