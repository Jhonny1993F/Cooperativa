@model Cooperativa.Models.Pasivos

@{
    Layout = "~/Views/Shared/AdministradorLayout.cshtml";
}

@{
    ViewData["Title"] = "Create";
}

<h1>Crear</h1>

<h4>Pasivos</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                @* <label asp-for="tipo" class="control-label"></label> *@
                <label>Tipo de pasivo:</label>
                <input asp-for="tipo" class="form-control" placeholder="Ejemplo: Matenimiento:"/>
                <span asp-validation-for="tipo" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="costoPasivo" class="control-label"></label> *@
                <label>Ingrese el costo del pasivo:</label>
                <input asp-for="costoPasivo" class="form-control" placeholder="Ejemplo: 15.25"/>
                <span asp-validation-for="costoPasivo" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="detalle" class="control-label"></label> *@
                <label>Detalle del pasivo:</label>
                <input asp-for="detalle" class="form-control" placeholder="Ejemplo: Mantenimiento de bodega"/>
                <span asp-validation-for="detalle" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="fechaPasivo" class="control-label"></label> *@
                <label>Fecha del pasivo:</label>
                <input type="text" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" readonly />
                @Html.HiddenFor(m => m.fechaPasivo, new { Value = DateTime.Now }) <!-- Campo oculto para la fecha -->
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Regresar al menu principal</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
